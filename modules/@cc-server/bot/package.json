{
	"private": true,
	"name": "@cc-server/bot",
	"version": "0.0.1",
	"description": "Bot logic for Creature Chess",
	"keywords": [],
	"author": "James Monger <jameskmonger@hotmail.co.uk>",
	"license": "ISC",
	"main": "./dist/index.js",
	"types": "./index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./dist/index.js"
		},
		"./internal": {
			"types": "./internal.ts",
			"default": "./dist/internal.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jameskmonger/creature-chess.git"
	},
	"scripts": {
		"build": "yarn run -T tsc -p ./tsconfig.json",
		"test": "yarn run -T jest --passWithNoTests",
		"lint": "yarn run -T eslint --ignore-path ../../../.eslintignore \"src/**/*.{ts,tsx}\" \"**/*.{ts,tsx}\" \"*.{ts,tsx}\" --no-error-on-unmatched-pattern"
	},
	"bugs": {
		"url": "https://github.com/Jameskmonger/creature-chess/issues"
	},
	"homepage": "https://github.com/Jameskmonger/creature-chess#readme",
	"dependencies": {
		"@creature-chess/board": "workspace:*",
		"@creature-chess/gamemode": "workspace:*",
		"@creature-chess/models": "workspace:*",
		"@creature-chess/utils": "workspace:*",
		"delay": "^4.4.1"
	},
	"peerDependencies": {
		"redux": "^4.1.0"
	}
}
