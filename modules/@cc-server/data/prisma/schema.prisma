generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bots {
  id           String @id @default(uuid())
  nickname     String @db.VarChar(20)
  games_played Int    @default(0)
  wins         Int    @default(0)

  // Discriminator. Matches a registered `BotEngine.id` (e.g. "utility").
  engine String @db.VarChar(64)
  // Engine-specific config. The bot implementation parses and validates
  // this — the server does not interpret it.
  meta   Json
}

model users {
  id           	  String  @id @default(uuid())
  auth_id         String  @db.VarChar(64)
  nickname        String? @db.VarChar(20)
  profile_title   Int?
  profile_picture Int?
  games_played    Int     @default(0)
  wins            Int     @default(0)
}

model guests {
  id           		String @id @default(uuid())
  created_at    	DateTime @default(now())
  updated_at    	DateTime @default(now()) @updatedAt

  token        		String @unique
  expires_at    	DateTime

  profile_picture 	Int?
}
