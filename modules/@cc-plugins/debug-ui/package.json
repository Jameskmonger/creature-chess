{
	"private": true,
	"name": "@cc-plugins/debug-ui",
	"version": "0.0.1",
	"description": "Developer mod that outlines every Region and labels its class - flip it on to see the full gamemode extension surface live on screen.",
	"author": "James Monger <jameskmonger@hotmail.co.uk>",
	"license": "ISC",
	"main": "./dist/client.js",
	"types": "./client.ts",
	"exports": {
		"./client": {
			"types": "./client.ts",
			"default": "./dist/client.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "yarn run -T tsc -p ./tsconfig.json",
		"build:web": "yarn run -T webpack -c ./webpack.config.js",
		"test": "yarn run -T jest --passWithNoTests",
		"lint": "yarn run -T eslint --ignore-path ../../../.eslintignore \"src/**/*.{ts,tsx}\" \"**/*.{ts,tsx}\" \"*.{ts,tsx}\" --no-error-on-unmatched-pattern"
	},
	"dependencies": {
		"@cc-plugins/api": "workspace:*",
		"@creature-chess/gamemode": "workspace:*",
		"react": "^18.2.0"
	}
}
