{
	"private": true,
	"name": "@creature-chess/gamemode",
	"version": "0.0.1",
	"description": "The Creature Chess gamemode implementation.",
	"keywords": [],
	"author": "James Monger <jameskmonger@hotmail.co.uk>",
	"license": "ISC",
	"main": "./dist/index.js",
	"types": "./index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./client.ts",
			"default": "./dist/client.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jameskmonger/creature-chess.git"
	},
	"scripts": {
		"build": "yarn run -T tsc -p ./tsconfig.json",
		"test": "yarn run -T jest --passWithNoTests",
		"lint": "yarn run -T eslint --ignore-path ../../../.eslintignore \"src/**/*.{ts,tsx}\" \"**/*.{ts,tsx}\" \"*.{ts,tsx}\" --no-error-on-unmatched-pattern"
	},
	"bugs": {
		"url": "https://github.com/Jameskmonger/creature-chess/issues"
	},
	"homepage": "https://github.com/Jameskmonger/creature-chess#readme",
	"dependencies": {
		"@cc-engine/kernel": "workspace:*",
		"@cc-plugins/api": "workspace:*",
		"@creature-chess/battle": "workspace:*",
		"@creature-chess/models": "workspace:*",
		"@reduxjs/toolkit": "^2.2.1",
		"@shoki/card-deck": "workspace:*",
		"@shoki/random": "workspace:*",
		"@types/lodash": "^4.14.178",
		"@types/uuid": "^8.3.3",
		"delay": "^4.4.1",
		"lodash": "^4.17.21",
		"p-defer": "^2.1.0",
		"uuid": "^8.3.2",
		"zod": "^4"
	}
}
