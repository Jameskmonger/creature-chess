{
	"compilerOptions": {
		"target": "ES2019",
		"module": "commonjs",
		"declaration": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"outDir": "./dist",
		"rootDir": "."
	},
	"include": ["./src/**/*", "./index.ts"]
}
